# Local Pixtral 12B checkpoint. Resolved against D:\OCR if relative.
# This application does not download weights and does not use OpenRouter.
LOCAL_PIXTRAL_MODEL_PATH=D:\OCR\models\pixtral-12b

# auto | cpu | cuda  (cuda only if the installed torch build reports CUDA)
LOCAL_PIXTRAL_DEVICE=auto

# float32 is the default. Smaller dtypes are only usable if your torch/transformers
# build and checkpoint actually support them; they are not verified here.
LOCAL_PIXTRAL_DTYPE=float32

LOCAL_PIXTRAL_MAX_NEW_TOKENS=512
LOCAL_PIXTRAL_MAX_IMAGE_SIDE=1280
